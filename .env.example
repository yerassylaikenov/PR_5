# PR5 — example environment file. Contains NO secrets.
# Copy to .env only if you need to override defaults. .env is git-ignored.

# Local JSON-RPC node (Hardhat), fixed by the assignment.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Web client. The contract address is read from deployments/localhost.json by
# default; set this only to override it.
# VITE_CONTRACT_ADDRESS=0x...
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337

# Monitor application-log HTTP endpoint (collector).
MONITOR_PORT=8787

# NOTE: all local accounts are derived from the PUBLIC Hardhat test mnemonic
# "test test test test test test test test test test test junk".
# These keys are world-known and MUST NEVER be used on a real network.
